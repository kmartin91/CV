{
  "name": "kevin-martin-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Server-rendered portfolio of Kevin Martin, fullstack developer — Vite + React SSR.",
  "scripts": {
    "dev": "node server.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node prerender.js",
    "preview": "vite preview --outDir dist/client",
    "serve": "cross-env NODE_ENV=production node server.js"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.4",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "express": "^4.19.2",
    "sirv": "^2.0.4",
    "typescript": "^5.5.4",
    "vite": "^8.1.5"
  }
}
